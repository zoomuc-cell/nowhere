<data-extraction-rules>
    <!-- Pro 구독 캐시는 백업·기기 이전에서 제외: 복원 후 Google Play로 다시 확인 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="nowhere_pro.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nowhere_pro.xml"/>
    </device-transfer>
</data-extraction-rules>
